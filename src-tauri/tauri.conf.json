{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Helper",
  "version": "0.1.0",
  "identifier": "com.githelper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Git Helper",
        "width": 1360,
        "height": 900,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
