{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Simplifier",
  "version": "0.1.0",
  "identifier": "com.githelper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Git Simplifier",
        "width": 1360,
        "height": 900,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Game Coder Studios",
    "copyright": "Copyright (c) 2026 Game Coder Studios",
    "category": "DeveloperTool",
    "shortDescription": "A safe control room for awkward Git operations",
    "longDescription": "Git Simplifier turns risky Git rewrites into reviewable, recoverable operations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
